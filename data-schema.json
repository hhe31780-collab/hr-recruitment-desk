{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "HR Recruiting RootState v1",
  "type": "object",
  "required": [
    "schemaVersion",
    "stages",
    "jobs",
    "candidates",
    "events",
    "assets",
    "metrics"
  ],
  "properties": {
    "schemaVersion": {
      "const": 1
    },
    "stages": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/stage"
      }
    },
    "jobs": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/job"
      }
    },
    "candidates": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/candidate"
      }
    },
    "events": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/event"
      }
    },
    "assets": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/asset"
      }
    },
    "metrics": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/metric"
      }
    }
  },
  "$defs": {
    "id": {
      "type": "string",
      "minLength": 1
    },
    "date": {
      "type": "string",
      "pattern": "^\\d{4}-\\d{2}-\\d{2}$"
    },
    "nullableDate": {
      "anyOf": [
        {
          "$ref": "#/$defs/date"
        },
        {
          "type": "null"
        }
      ]
    },
    "stage": {
      "type": "object",
      "required": [
        "id",
        "name",
        "kind"
      ],
      "properties": {
        "id": {
          "$ref": "#/$defs/id"
        },
        "name": {
          "type": "string",
          "minLength": 1
        },
        "kind": {
          "enum": [
            "active",
            "hired",
            "rejected"
          ]
        }
      }
    },
    "job": {
      "type": "object",
      "required": [
        "id",
        "department",
        "name",
        "headcount",
        "owner",
        "city",
        "level",
        "salary",
        "publishedAt",
        "deadline",
        "status"
      ],
      "properties": {
        "id": {
          "$ref": "#/$defs/id"
        },
        "department": {
          "type": "string"
        },
        "name": {
          "type": "string",
          "minLength": 1
        },
        "headcount": {
          "type": "integer",
          "minimum": 1
        },
        "owner": {
          "type": "string"
        },
        "city": {
          "type": "string"
        },
        "level": {
          "type": "string"
        },
        "salary": {
          "type": "string"
        },
        "jd": {
          "type": "string",
          "description": "岗位 JD，保存多行纯文本；旧岗位未填写时可省略。"
        },
        "publishedAt": {
          "$ref": "#/$defs/date"
        },
        "deadline": {
          "anyOf": [
            {
              "$ref": "#/$defs/date"
            },
            {
              "const": ""
            }
          ]
        },
        "status": {
          "enum": [
            "招聘中",
            "暂停",
            "已关闭"
          ]
        },
        "warehouseHiddenAt": {
          "type": "string",
          "format": "date-time"
        }
      }
    },
    "reviews": {
      "type": "object",
      "required": [
        "resume",
        "first",
        "second",
        "third",
        "offer"
      ],
      "properties": {
        "resume": {
          "enum": [
            "pending",
            "pass",
            "fail"
          ]
        },
        "first": {
          "enum": [
            "pending",
            "pass",
            "fail"
          ]
        },
        "second": {
          "enum": [
            "pending",
            "pass",
            "fail"
          ]
        },
        "third": {
          "enum": [
            "pending",
            "pass",
            "fail"
          ]
        },
        "offer": {
          "enum": [
            "pending",
            "sent",
            "accepted",
            "rejected"
          ]
        }
      }
    },
    "history": {
      "type": "object",
      "required": [
        "id",
        "from",
        "to",
        "at",
        "note"
      ],
      "properties": {
        "id": {
          "$ref": "#/$defs/id"
        },
        "from": {
          "type": [
            "string",
            "null"
          ]
        },
        "to": {
          "type": "string"
        },
        "at": {
          "type": "string",
          "format": "date-time"
        },
        "note": {
          "type": "string"
        },
        "label": {
          "type": "string"
        }
      }
    },
    "candidate": {
      "type": "object",
      "required": [
        "id",
        "name",
        "phone",
        "email",
        "jobId",
        "stageId",
        "owner",
        "source",
        "city",
        "experience",
        "education",
        "salary",
        "tags",
        "notes",
        "appliedAt",
        "createdAt",
        "updatedAt",
        "reviews",
        "hiredAt",
        "history"
      ],
      "properties": {
        "id": {
          "$ref": "#/$defs/id"
        },
        "name": {
          "type": "string",
          "minLength": 1
        },
        "phone": {
          "type": "string"
        },
        "email": {
          "type": "string"
        },
        "jobId": {
          "type": "string"
        },
        "stageId": {
          "$ref": "#/$defs/id"
        },
        "owner": {
          "type": "string"
        },
        "source": {
          "type": "string"
        },
        "city": {
          "type": "string"
        },
        "experience": {
          "type": "string"
        },
        "education": {
          "type": "string"
        },
        "school": {
          "type": "string",
          "description": "学校名称，可选纯文本；旧候选人未填写时可省略。"
        },
        "salary": {
          "type": "string"
        },
        "tags": {
          "type": "string"
        },
        "notes": {
          "type": "string"
        },
        "appliedAt": {
          "$ref": "#/$defs/date"
        },
        "createdAt": {
          "type": "string",
          "format": "date-time"
        },
        "updatedAt": {
          "type": "string",
          "format": "date-time"
        },
        "reviews": {
          "$ref": "#/$defs/reviews"
        },
        "hiredAt": {
          "$ref": "#/$defs/nullableDate"
        },
        "history": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/history"
          }
        }
      }
    },
    "event": {
      "type": "object",
      "required": [
        "id",
        "title",
        "type",
        "candidateId",
        "date",
        "time",
        "notes",
        "done"
      ],
      "properties": {
        "id": {
          "$ref": "#/$defs/id"
        },
        "title": {
          "type": "string",
          "minLength": 1
        },
        "type": {
          "enum": [
            "面试",
            "Offer",
            "入职",
            "跟进",
            "待办"
          ]
        },
        "candidateId": {
          "type": "string"
        },
        "date": {
          "anyOf": [
            {
              "$ref": "#/$defs/date"
            },
            {
              "const": ""
            }
          ]
        },
        "time": {
          "type": "string",
          "pattern": "^$|^([01][0-9]|2[0-3]):[0-5][0-9]$"
        },
        "notes": {
          "type": "string"
        },
        "done": {
          "type": "boolean"
        },
        "bucket": {
          "enum": [
            "schedule",
            "short",
            "long"
          ]
        }
      },
      "allOf": [
        {
          "if": {
            "not": {
              "properties": {
                "bucket": {
                  "enum": [
                    "short",
                    "long"
                  ]
                }
              },
              "required": [
                "bucket"
              ]
            }
          },
          "then": {
            "properties": {
              "date": {
                "$ref": "#/$defs/date"
              },
              "time": {
                "type": "string",
                "pattern": "^([01][0-9]|2[0-3]):[0-5][0-9]$"
              }
            }
          }
        }
      ]
    },
    "asset": {
      "type": "object",
      "required": [
        "id",
        "name",
        "kind",
        "category",
        "createdAt"
      ],
      "properties": {
        "id": {
          "$ref": "#/$defs/id"
        },
        "name": {
          "type": "string"
        },
        "kind": {
          "enum": [
            "document",
            "resource",
            "attachment"
          ]
        },
        "category": {
          "type": "string"
        },
        "createdAt": {
          "type": "string",
          "format": "date-time"
        },
        "candidateId": {
          "type": [
            "string",
            "null"
          ]
        },
        "size": {
          "type": "number",
          "minimum": 0
        },
        "mime": {
          "type": "string"
        },
        "url": {
          "type": "string",
          "pattern": "^https?://"
        }
      },
      "oneOf": [
        {
          "required": [
            "url"
          ]
        },
        {
          "required": [
            "size",
            "mime"
          ],
          "not": {
            "required": [
              "url"
            ]
          }
        }
      ]
    },
    "measure": {
      "enum": [
        "total",
        "resumeDone",
        "resumePass",
        "firstDone",
        "firstPass",
        "secondDone",
        "secondPass",
        "thirdDone",
        "thirdPass",
        "offerSent",
        "offerAccepted",
        "hired"
      ]
    },
    "metric": {
      "type": "object",
      "required": [
        "id",
        "name",
        "numerator",
        "denominator"
      ],
      "properties": {
        "id": {
          "$ref": "#/$defs/id"
        },
        "name": {
          "type": "string",
          "minLength": 1
        },
        "numerator": {
          "$ref": "#/$defs/measure"
        },
        "denominator": {
          "$ref": "#/$defs/measure"
        },
        "custom": {
          "type": "boolean"
        }
      }
    }
  }
}
